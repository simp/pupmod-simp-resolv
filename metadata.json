{
  "name": "simp-resolv",
  "version": "1.0.1",
  "author": "SIMP Team",
  "summary": "A SIMP Puppet module for managing client-side DNS settings",
  "license": "Apache-2.0",
  "source": "https://github.com/simp/pupmod-simp-resolv",
  "project_page": "https://github.com/simp/pupmod-simp-resolv",
  "issues_url": "https://github.com/simp/pupmod-simp-resolv/issues",
  "tags": [
    "simp",
    "dns",
    "resolv.conf"
  ],
  "dependencies": [
    {
      "name": "simp/simplib",
      "version_requirement": ">= 4.9.0 < 6.0.0"
    },
    {
      "name": "simp/named",
      "version_requirement": ">= 6.0.0 < 8.0.0"
    },
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "CentOS",
      "operatingsystemrelease": [
        "9",
        "10"
      ]
